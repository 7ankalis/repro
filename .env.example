# --- Meta Model API (OpenAI-compatible) ---
MODEL_API_KEY=
REPRO_BASE_URL=https://api.meta.ai/v1
REPRO_MODEL=muse-spark-1.3
# DO NOT use *-contributor models with real reports (provider may train on them). Code refuses unless:
# REPRO_ALLOW_CONTRIBUTOR=1
# USD per 1M tokens (Meta models page, standard endpoint)
REPRO_PRICE_IN=1.25
REPRO_PRICE_CACHED=0.15
REPRO_PRICE_OUT=4.25

# Optional escalation model for the hardest steps (task A9). Expensive: $4 in / $0.20 cached / $20 out per 1M.
REPRO_STRONG_MODEL=
REPRO_STRONG_PRICE_IN=4.00
REPRO_STRONG_PRICE_CACHED=0.20
REPRO_STRONG_PRICE_OUT=20.00

# --- Baseten: Muse Spark Open (Meta open-weights), OpenAI-compatible. $100 credits, up to 2M tokens/min. Used for claim extraction (REPRO_CLAIM_MODEL=cheap),
#     dataset generation and model comparisons. Copy the exact base URL + model id from your Baseten dashboard.
REPRO_CHEAP_BASE_URL=https://inference.baseten.co/v1
REPRO_CHEAP_API_KEY=
REPRO_CHEAP_MODEL=meta-models/muse-spark-open-1026   # exact hackathon id; the key works only with this model
# Muse Spark Open always reasons; effort low|medium|high|xhigh (provider default xhigh = slow + token-hungry)
REPRO_CHEAP_REASONING_EFFORT=low
REPRO_CHEAP_PRICE_IN=0
REPRO_CHEAP_PRICE_OUT=0
# main = Muse Spark 1.3 extracts claims, cheap = Muse Spark Open on Baseten extracts claims
REPRO_CLAIM_MODEL=main

# --- Optional: GitHub bot ---
GITHUB_TOKEN=
REPRO_GITHUB_REPO=7ankalis/repro-demo
